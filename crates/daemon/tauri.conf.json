{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aw-manual",
  "mainBinaryName": "aw-manual-daemon",
  "version": "0.1.0",
  "identifier": "io.github.arstulke.aw-manual",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Manual activity tracking for ActivityWatch",
    "longDescription": "aw-manual records what you are working on (client, project, task) into an ActivityWatch bucket, using a popover, the tray, global hotkeys (including mouse buttons) and a CLI.",
    "copyright": "MPL-2.0",
    "license": "MPL-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "wix": {
        "fragmentPaths": [
          "windows/path-fragment.wxs"
        ],
        "componentRefs": [
          "AwManualCliPath"
        ]
      },
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  }
}
